# ===== CareerReady server =====
NODE_ENV=development
PORT=6000
HOST=0.0.0.0
# Public address of the site. Used in email links. In production: https://your-app.onrender.com
APP_URL=http://localhost:5173
# DATA_DIR=/var/data
# Only needed if the frontend is hosted on a different domain than the API:
# CORS_ORIGIN=http://localhost:5173

# ===== Email (needed for email verification, password reset and mentor notifications) =====
# Preferred on Render: an HTTPS email API (outbound SMTP ports can be blocked). Resend: https://resend.com
# If RESEND_API_KEY is set it is used instead of SMTP. MAIL_FROM must be an address on a domain you verified there.
RESEND_API_KEY=
# Free options: Brevo (300/day), Gmail with an App Password, Resend SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CareerReady <you@example.com>"

# ===== AI (optional): resume review, interview feedback, mentor session briefs =====
# Free option: Google Gemini. Get a key at https://aistudio.google.com/apikey
# If GEMINI_API_KEY is set it is used; otherwise OPENAI_API_KEY (needs paid credits).
GEMINI_API_KEY=
GEMINI_MODEL=Gemini 3.8 Live

# ===== SMS (optional) via Twilio: mentor request / session alerts =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin bootstrap: sign up normally, then run:  npm run promote-admin -- you@example.com
